{
  "name": "bookink",
  "private": true,
  "workspaces": [
    "services/*",
    "packages/*",
    "frontend/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test:unit": "bun test services/user/tests/unit services/catalog/tests/unit services/payment/tests/unit services/appointment/tests/unit",
    "test:unit:frontend": "bun run --cwd frontend test",
    "test:interaction:frontend": "bun run --cwd frontend test:interaction",
    "test:e2e:frontend": "bun run --cwd frontend test:e2e",
    "test:e2e:frontend:ui": "bun run --cwd frontend test:e2e:ui",
    "test:integration:user": "bun run --cwd services/user test:integration",
    "test:integration:catalog": "bun run --cwd services/catalog test:integration",
    "test:integration:appointment": "bun run --cwd services/appointment test:integration",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:prune": "docker compose down -v --remove-orphans",
    "docker:dev:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:prune": "docker compose -f docker-compose.dev.yml down -v --remove-orphans",
    "prisma:migrate:dev:user": "bun prisma migrate dev --config services/user/prisma.config.ts",
    "prisma:generate:user": "bunx prisma generate --config services/user/prisma.config.ts",
    "prisma:studio:user": "bunx prisma studio --config services/user/prisma.config.ts",
    "prisma:status:prod:user": "PRISMA_TARGET=production bunx prisma migrate status --config services/user/prisma.config.ts",
    "prisma:migrate:deploy:prod:user": "PRISMA_TARGET=production bunx prisma migrate deploy --config services/user/prisma.config.ts",
    "prisma:migrate:dev:appointment": "bun prisma migrate dev --config services/appointment/prisma.config.ts",
    "prisma:generate:appointment": "bunx prisma generate --config services/appointment/prisma.config.ts",
    "prisma:studio:appointment": "bunx prisma studio --config services/appointment/prisma.config.ts",
    "prisma:status:prod:appointment": "PRISMA_TARGET=production bunx prisma migrate status --config services/appointment/prisma.config.ts",
    "prisma:migrate:deploy:prod:appointment": "PRISMA_TARGET=production bunx prisma migrate deploy --config services/appointment/prisma.config.ts",
    "prisma:migrate:dev:catalog": "bun prisma migrate dev --config services/catalog/prisma.config.ts",
    "prisma:generate:catalog": "bunx prisma generate --config services/catalog/prisma.config.ts",
    "prisma:studio:catalog": "bunx prisma studio --config services/catalog/prisma.config.ts",
    "prisma:status:prod:catalog": "PRISMA_TARGET=production bunx prisma migrate status --config services/catalog/prisma.config.ts",
    "prisma:migrate:deploy:prod:catalog": "PRISMA_TARGET=production bunx prisma migrate deploy --config services/catalog/prisma.config.ts",
    "prisma:migrate:dev:payment": "bun prisma migrate dev --config services/payment/prisma.config.ts",
    "prisma:generate:payment": "bunx prisma generate --config services/payment/prisma.config.ts",
    "prisma:studio:payment": "bunx prisma studio --config services/payment/prisma.config.ts",
    "prisma:status:prod:payment": "PRISMA_TARGET=production bunx prisma migrate status --config services/payment/prisma.config.ts",
    "prisma:migrate:deploy:prod:payment": "PRISMA_TARGET=production bunx prisma migrate deploy --config services/payment/prisma.config.ts",
    "stripe:listen": "stripe listen --all-snapshot --forward-to localhost:8000/webhooks/billing"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "bun-types": "1.4.2",
    "dotenv": "^17.4.2",
    "globals": "^17.6.0",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "@nestjs/swagger": "^11.4.4",
    "@prisma/adapter-pg": "^7.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1"
  }
}
