{
  "name": "bookink",
  "private": true,
  "workspaces": [
    "services/*",
    "packages/*",
    "frontend/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test:unit": "bun test services/user/tests/unit",
    "test:integration:user": "bun run --cwd services/user test:integration",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:prune": "docker compose down -v --remove-orphans",
    "docker:dev:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:prune": "docker compose -f docker-compose.dev.yml down -v --remove-orphans",
    "prisma:migrate:dev:user": "bun prisma migrate dev --config services/user/prisma.config.ts",
    "prisma:generate:user": "bunx prisma generate --config services/user/prisma.config.ts",
    "prisma:studio:user": "bunx prisma studio --config services/user/prisma.config.ts",
    "prisma:migrate:dev:appointment": "bun prisma migrate dev --config services/appointment/prisma.config.ts",
    "prisma:generate:appointment": "bunx prisma generate --config services/appointment/prisma.config.ts",
    "prisma:studio:appointment": "bunx prisma studio --config services/appointment/prisma.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "bun-types": "latest",
    "dotenv": "^17.4.2",
    "globals": "^17.6.0",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "@nestjs/swagger": "^11.4.4",
    "@prisma/adapter-pg": "^7.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1"
  }
}