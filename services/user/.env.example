# Example environment variables for the User service
PORT=8081

# Environment variables for the User service
DATABASE_URL="postgresql://admin:admin@postgres:5432/user"

# Banco de produção (Railway → Postgres → Variables → DATABASE_PUBLIC_URL, com /user no fim).
# Usado só pelos scripts prisma:*:prod:user, nunca pela aplicação
DATABASE_PROD_URL=""

# Database and RabbitMQ connection URLs
RABBITMQ_URL="amqp://admin:admin@rabbitmq:5672"

# Segredo usado para assinar e validar o accessToken (JWT) da sessão
JWT_SECRET="change-me"
JWT_EXPIRES_IN="15m"

# Segredo que o servidor do frontend (NextAuth) envia no header X-Internal-Secret
# para chamar POST /auth/oauth/upsert. Mínimo de 32 caracteres (openssl rand -hex 32)
INTERNAL_API_SECRET="change-me-to-a-random-32-char-secret"

# Storage (S3) — compartilhado entre os serviços via @bookink/shared
S3_REGION="us-east-1"
S3_BUCKET="bookink-assets-dev"
S3_ACCESS_KEY_ID="change-me"
S3_SECRET_ACCESS_KEY="change-me"
# Só necessário para endpoint S3-compatível em dev local (ex: MinIO)
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
# Opcional: use para servir via CDN (ex: CloudFront) em vez da URL direta do bucket
S3_PUBLIC_BASE_URL=""

# Mail (SMTP via nodemailer) — compartilhado entre os serviços via @bookink/shared
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="465"
MAIL_SECURE="true"
MAIL_USER="email@gmail.com"
MAIL_PASSWORD="change-me"
MAIL_FROM="email@gmail.com"

# URL do frontend usada para montar o link de redefinição de senha enviado por email
FRONTEND_RESET_PASSWORD_URL="http://localhost:3000/reset-password"

# Redis — cache das rotas públicas (TTL de 15 min, renovado por uma única requisição perto de vencer)
REDIS_URL="redis://localhost:6379"
CACHE_TTL_SECONDS="900"
CACHE_REFRESH_AHEAD_SECONDS="30"
