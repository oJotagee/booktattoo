# Example environment variables for the User service
PORT=8081

# Environment variables for the User service
DATABASE_URL="postgresql://admin:admin@postgres:5432/user"

# Database and RabbitMQ connection URLs
RABBITMQ_URL="amqp://admin:admin@rabbitmq:5672"

# Segredo usado para assinar e validar o accessToken (JWT) da sessão
JWT_SECRET="change-me"
JWT_EXPIRES_IN="15m"

# Storage (S3) — compartilhado entre os serviços via @bookink/shared
S3_REGION="us-east-1"
S3_BUCKET="bookink-assets-dev"
S3_ACCESS_KEY_ID="change-me"
S3_SECRET_ACCESS_KEY="change-me"
# Só necessário para endpoint S3-compatível em dev local (ex: MinIO)
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
# Opcional: use para servir via CDN (ex: CloudFront) em vez da URL direta do bucket
S3_PUBLIC_BASE_URL=""