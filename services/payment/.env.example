# Example environment variables for the Payment service (Stripe)
PORT=8084

# Environment variables for the Payment service
DATABASE_URL="postgresql://admin:admin@postgres:5432/payment"

# Banco de produção (Railway → Postgres → Variables → DATABASE_PUBLIC_URL, com /payment no fim).
# Usado só pelos scripts prisma:*:prod:payment, nunca pela aplicação
DATABASE_PROD_URL=""

# Database and RabbitMQ connection URLs
RABBITMQ_URL="amqp://admin:admin@rabbitmq:5672"

# Mesmo segredo do user-service: aqui o accessToken (JWT) só é validado, nunca emitido
JWT_SECRET="change-me"

# Stripe — a secret key e o webhook secret nunca saem do backend
STRIPE_SECRET_KEY="sk_test_change-me"
# Em dev: `stripe listen --forward-to localhost:8000/webhooks/billing` imprime o whsec_
STRIPE_BILLING_WEBHOOK_SECRET="whsec_change-me"

# Price IDs dos planos (Dashboard Stripe > Product catalog)
STRIPE_PRICE_BASIC="price_change-me"
STRIPE_PRICE_PROFESSIONAL="price_change-me"

# Para onde o Stripe redireciona o tatuador depois do checkout / portal
STRIPE_CHECKOUT_SUCCESS_URL="http://localhost:3000/dashboard/plans?checkout=success"
STRIPE_CHECKOUT_CANCEL_URL="http://localhost:3000/dashboard/plans?checkout=canceled"
STRIPE_PORTAL_RETURN_URL="http://localhost:3000/dashboard/plans"
