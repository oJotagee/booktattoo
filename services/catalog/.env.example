# Example environment variables for the Catalog service (services + galeria)
PORT=8083

# Environment variables for the Catalog service
DATABASE_URL="postgresql://admin:admin@postgres:5432/catalog"

# Database and RabbitMQ connection URLs
RABBITMQ_URL="amqp://admin:admin@rabbitmq:5672"

# Mesmo segredo do user-service: aqui o accessToken (JWT) só é validado, nunca emitido
JWT_SECRET="change-me"
