# Example environment variables for the Catalog service (services + galeria)
PORT=8083

# Environment variables for the Catalog service
DATABASE_URL="postgresql://admin:admin@postgres:5432/catalog"

# Database and RabbitMQ connection URLs
RABBITMQ_URL="amqp://admin:admin@rabbitmq:5672"

# Mesmo segredo do user-service: aqui o accessToken (JWT) só é validado, nunca emitido
JWT_SECRET="change-me"

# Storage (S3) — compartilhado entre os serviços via @bookink/shared
S3_REGION="us-east-1"
S3_BUCKET="bookink-assets-dev"
S3_ACCESS_KEY_ID="change-me"
S3_SECRET_ACCESS_KEY="change-me"
# Só necessário para endpoint S3-compatível em dev local (ex: MinIO)
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
# Opcional: use para servir via CDN (ex: CloudFront) em vez da URL direta do bucket
S3_PUBLIC_BASE_URL=""

# URL interna do user-service, para checar o plano (trial/limites) ao criar serviço ou flash
USER_SERVICE_URL="http://user:8081"
