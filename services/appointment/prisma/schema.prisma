generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Reminder {
  id          String @id @default(cuid())
  description String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String

  @@index([userId])
}

enum BookingRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model BookingRequest {
  id            String               @id @default(cuid())
  clientName    String
  clientContact String
  message       String?
  status        BookingRequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String

  appointment Appointment?

  @@index([userId])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Appointment {
  id            String            @id @default(cuid())
  clientName    String
  clientEmail   String
  clientPhone   String
  scheduledAt   DateTime
  duration      Int // congelado no momento da criação
  price         Int // congelado no momento da criação
  depositAmount Int // congelado no momento da criação
  status        AppointmentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String

  serviceId      String?
  // Sem @unique: um flash cancelado pode ser reservado de novo. A regra de
  // "um agendamento ativo por flash" fica no use case
  galeryId       String?
  galeryTitle    String? // congelado no momento da criação
  galeryImageUrl String? // congelado no momento da criação

  checkoutSessionId String?   @unique
  paidAt            DateTime?
  refundId          String?   @unique
  refundedAt        DateTime?

  bookingRequestId String?         @unique
  bookingRequest   BookingRequest? @relation(fields: [bookingRequestId], references: [id])

  @@index([userId, scheduledAt])
  @@index([galeryId])
}
