generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Reminder {
  id          String @id @default(cuid())
  description String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String

  @@index([userId])
}

enum BookingRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model BookingRequest {
  id            String               @id @default(cuid())
  clientName    String
  clientContact String
  message       String?
  status        BookingRequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String

  appointment Appointment?

  @@index([userId])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Appointment {
  id            String            @id @default(cuid())
  clientName    String
  clientContact String
  scheduledAt   DateTime
  duration      Int // congelado no momento da criação
  price         Int // congelado no momento da criação
  status        AppointmentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String

  serviceId String?
  galeryId  String? @unique

  bookingRequestId String?         @unique
  bookingRequest   BookingRequest? @relation(fields: [bookingRequestId], references: [id])

  @@index([userId])
}
