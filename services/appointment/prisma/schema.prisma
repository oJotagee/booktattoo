generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Reminder {
  id          String @id @default(cuid())
  description String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String

  @@index([userId])
}

enum BookingRequestStatus {
  OPEN
  CLOSED
}

model BookingRequest {
  id            String               @id @default(cuid())
  clientName    String
  clientEmail   String
  clientPhone   String
  status        BookingRequestStatus @default(OPEN)
  lastMessageAt DateTime             @default(now())
  closedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String

  messages     BookingRequestMessage[]
  offers       BookingOffer[]
  appointments Appointment[]

  @@index([userId, status, lastMessageAt])
  @@index([clientEmail])
  @@index([clientPhone])
}

enum BookingRequestMessageAuthor {
  ARTIST
  CLIENT
  SYSTEM
}

enum BookingOfferStatus {
  PENDING
  PAID
  WITHDRAWN
  CANCELLED
}

model BookingOffer {
  id            String             @id @default(cuid())
  title         String
  scheduledAt   DateTime
  duration      Int
  price         Int
  depositAmount Int
  status        BookingOfferStatus @default(PENDING)
  appointmentId String?
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingRequestId String
  bookingRequest   BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  @@index([bookingRequestId, status])
}

model BookingRequestMessage {
  id     String                      @id @default(cuid())
  author BookingRequestMessageAuthor
  body   String

  createdAt DateTime @default(now())

  bookingRequestId String
  bookingRequest   BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)

  @@index([bookingRequestId, createdAt])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Appointment {
  id            String            @id @default(cuid())
  clientName    String
  clientEmail   String
  clientPhone   String
  scheduledAt   DateTime
  duration      Int // congelado no momento da criação
  price         Int // congelado no momento da criação
  depositAmount Int // congelado no momento da criação
  status        AppointmentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String

  serviceId      String?
  // Sem @unique: um flash cancelado pode ser reservado de novo. A regra de
  // "um agendamento ativo por flash" fica no use case
  galeryId       String?
  // Título congelado: do flash, ou da proposta quando galeryId é nulo
  galeryTitle    String?
  galeryImageUrl String? // congelado no momento da criação

  checkoutSessionId String?   @unique
  paidAt            DateTime?
  refundId          String?   @unique
  refundedAt        DateTime?

  // Sem @unique: uma proposta pode gerar várias tentativas de pagamento
  bookingRequestId String?
  bookingRequest   BookingRequest? @relation(fields: [bookingRequestId], references: [id])
  bookingOfferId   String?
  bookingOffer     BookingOffer?   @relation(fields: [bookingOfferId], references: [id])

  @@index([userId, scheduledAt])
  @@index([galeryId])
  @@index([bookingRequestId])
  @@index([bookingOfferId, status])
}
