generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Appointment {
  id              String   @id @default(cuid())
  name            String
  email           String
  phone           String
  appointmentDate DateTime
  time            String
  status          String   @default("scheduled") // "scheduled" | "cancelled" | "completed"

  userId    String
  serviceId String

  serviceName     String
  servicePrice    Int
  serviceDuration Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([serviceId])
}
