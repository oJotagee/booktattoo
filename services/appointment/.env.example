# Example environment variables for the Appointment service
PORT=8082

# Environment variables for the Appointment service
DATABASE_URL="postgresql://admin:admin@postgres:5432/appointment"

# Banco de produção (Railway → Postgres → Variables → DATABASE_PUBLIC_URL, com /appointment no fim).
# Usado só pelos scripts prisma:*:prod:appointment, nunca pela aplicação
DATABASE_PROD_URL=""

# Database and RabbitMQ connection URLs
RABBITMQ_URL="amqp://admin:admin@rabbitmq:5672"

# Mesmo segredo do user-service: aqui o accessToken (JWT) só é validado, nunca emitido
JWT_SECRET="change-me"

# URL interna do user-service, para validar o user ao criar um agendamento
USER_SERVICE_URL="http://user:8081"

# URL interna do catalog-service, para validar service/galery ao criar um agendamento
CATALOG_SERVICE_URL="http://catalog:8083"

# URL interna do payment-service, para abrir o checkout do sinal (POST /internal/deposits/checkout)
PAYMENT_SERVICE_URL="http://payment:8084"

# Mesmo segredo configurado no payment-service; vai no header X-Internal-Secret
INTERNAL_API_SECRET="change-me-to-a-random-32-char-secret"

# Assina os links /pedido/<token> que dão ao cliente acesso à conversa com o tatuador (mínimo de 32 caracteres).
# Trocar este valor invalida todos os links já enviados
BOOKING_LINK_SECRET="change-me-to-a-random-32-char-secret"

# Para onde o Stripe devolve o cliente depois do checkout do sinal (/{artistId}?booking=...)
FRONTEND_URL="http://localhost:3000"

# Redis — cache da rota pública de horários ocupados (TTL de 15 min, renovado por uma única requisição perto de vencer)
REDIS_URL="redis://localhost:6379"
CACHE_TTL_SECONDS="900"
CACHE_REFRESH_AHEAD_SECONDS="30"

# Mail (SMTP via nodemailer) — e-mails de confirmação e estorno enviados ao cliente
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="465"
MAIL_SECURE="true"
MAIL_USER="email@gmail.com"
MAIL_PASSWORD="change-me"
MAIL_FROM="email@gmail.com"
