# Environment variables for the frontend application
NODE_ENV="development"

# Environment variables for NextAuth authentication
AUTH_SECRET=""

# GitHub OAuth credentials
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# URL do API gateway (Kong) — roteia para user, catalog e appointment
API_URL="http://localhost:8000"

# Segredo compartilhado com o user-service para chamar POST /auth/oauth/upsert.
# Mesmo valor do INTERNAL_API_SECRET do user-service (gere com: openssl rand -hex 32)
INTERNAL_API_SECRET=""
